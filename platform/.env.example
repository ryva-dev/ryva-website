NODE_ENV=development
APP_URL=http://127.0.0.1:5173
PORT=8787
DATABASE_URL=postgres://localhost/ryva_pro_dev
PGSSL=disable
PG_POOL_MAX=10
LOG_LEVEL=info

# Public build-time identifier for Google Analytics 4. Leave empty to disable analytics.
VITE_GA_MEASUREMENT_ID=
# Public build-time project identifier for Microsoft Clarity. Leave empty to disable recordings.
VITE_CLARITY_PROJECT_ID=
# Public build-time identifier for consent-gated Meta Pixel tracking.
VITE_META_PIXEL_ID=
# Public build-time identifier for consent-gated TikTok Pixel tracking.
VITE_TIKTOK_PIXEL_ID=

# Generate with: openssl rand -hex 32
SESSION_PEPPER=
FIELD_ENCRYPTION_KEY=
SESSION_TTL_HOURS=168
TRUST_PROXY=0

# Credential provider. Production requires a signed webhook secret and may
# optionally use a provider API for user-initiated refresh.
CREDENTIAL_WEBHOOK_SECRET=
CREDENTIAL_API_URL=
CREDENTIAL_API_TOKEN=

# Optional external intelligence source. Returned candidates must still be
# recorded with provenance and accepted by a human; provider data never qualifies a record.
INTELLIGENCE_API_URL=
INTELLIGENCE_API_TOKEN=

# Evidence-first AI copilot. Core workflows remain manual when disabled.
# The provider must accept schema-constrained requests and must not receive tools.
AI_PROVIDER_URL=
AI_PROVIDER_TOKEN=
AI_MODEL=provider-default
AI_MODEL_VERSION=unknown
AI_GENERATION_ENABLED=0
AI_PROVIDER_RETENTION_MODE=zero_data_retention
AI_ALLOW_PROVIDER_TRAINING=0
AI_TIMEOUT_MS=30000
AI_MAX_CONTEXT_ITEMS=50

# Resend email API (base URL: https://api.resend.com). External outreach sends
# remain disabled unless explicitly enabled after launch review.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
EMAIL_WEBHOOK_SECRET=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=
OUTREACH_SEND_ENABLED=0

# Transactional account email is separate from customer outreach. Password
# reset delivery fails safely when these values are not configured.
TRANSACTIONAL_EMAIL_PROVIDER_URL=
TRANSACTIONAL_EMAIL_PROVIDER_TOKEN=
TRANSACTIONAL_EMAIL_FROM_ADDRESS=
PASSWORD_RESET_TTL_MINUTES=60

# Server-authoritative Ryva Pro period created by first Program completion.
RYVA_PRO_TRIAL_DAYS=30

# Versioned legal documents presented during account registration.
TERMS_DOCUMENT_URL=
TERMS_DOCUMENT_VERSION=2026-10-02
PRIVACY_DOCUMENT_URL=
PRIVACY_DOCUMENT_VERSION=2026-10-02
REFUND_POLICY_DOCUMENT_URL=
REFUND_POLICY_DOCUMENT_VERSION=2026-10-02
DISCLAIMER_DOCUMENT_URL=
DISCLAIMER_DOCUMENT_VERSION=2026-10-02

# Billing provider. Production requires all three Stripe values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time $397 Program price. Ryva Pro uses STRIPE_PRICE_ID separately.
STRIPE_PROGRAM_PRICE_ID=
PROGRAM_PRICE_CENTS=39700
PROGRAM_PRICE_CURRENCY=usd
STRIPE_PRICE_ID=
RYVA_PRO_PRICE_CENTS=2000
RYVA_PRO_PRICE_CURRENCY=usd

# Documents. Production requires S3 and a signed malware-scanner callback.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.data/documents
S3_BUCKET=
S3_REGION=
# AWS SDK default credential chain. Required for a Railway-hosted process using
# an IAM access key; AWS_SESSION_TOKEN is only required for temporary credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Leave empty for AWS S3. Set only for a non-AWS S3-compatible provider.
S3_ENDPOINT=
MALWARE_SCANNER_WEBHOOK_SECRET=

# Operations
SUPPORT_EMAIL=support@ryvaforge.com
JOB_WORKER_ENABLED=0
CONTROLLED_LAUNCH_ENABLED=0
JOB_POLL_INTERVAL_MS=5000
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_LOGIN_MAX=10

# Synthetic-only local setup. Never enable in production.
ALLOW_SYNTHETIC_SEED=1
